#version 450
// SPDX-License-Identifier: Apache-2.0
// Indirect mesh-only workgroup clamp and draw-argument initializer (aligned with iOS mxe_monly #1542).
// Reads NVN2 DrawMeshTasksIndirect {count, first} at ind[ind_word_off..+1], writes clamped
// VkDispatchIndirectCommand into h[8..10], initializes VkDrawIndexedIndirectCommand h[13..17],
// records raw count into h[18] (h[19] = 0), and copies first to h[29] and h[h[30]].
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) buffer Exchange { uint h[]; };
layout(set = 0, binding = 1) readonly buffer Indirect { uint ind[]; };
layout(push_constant) uniform PC { uint ind_word_off; } pc;

void main() {
    uint cnt = ind[pc.ind_word_off];
    uint first = ind[pc.ind_word_off + 1u];
    h[8]  = min(cnt, h[4]);
    h[9]  = 1u;
    h[10] = 1u;
    h[13] = 0u;
    h[14] = 1u;
    h[15] = 0u;
    h[16] = 0u;
    h[17] = 0u;
    h[18] = cnt;
    h[19] = 0u;
    h[29] = first;
    uint fa = h[30];
    if (fa >= 32u) h[fa] = first;
}
