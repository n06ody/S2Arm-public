<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Optional so the shell can explain unsupported hardware. -->
    <uses-feature android:name="android.hardware.vulkan.version"
        android:version="0x00401000" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:appCategory="game" android:label="${appLabel}" android:theme="@style/AppTheme"
        android:isGame="true" android:resizeableActivity="false"
        android:icon="${appIcon}" android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true"
        android:pageSizeCompat="disabled">
        <!-- #48 A4：两个 supports 都 false = 不接管 Game Mode 优化，保留 OEM 厂商干预；
             系统省电档由应用内轮询 getGameMode() 读到后限直连 present 周期。 -->
        <meta-data android:name="android.game_mode_config" android:resource="@xml/game_mode_config" />
        <!-- Rotation / resize reach surfaceChanged (swapchain rebuild) instead of recreating the activity.
             screenOrientation (app/build.gradle): a per-game app runs landscape either way up, as the
             first version's screen configuration assumes (implementation plan §7.4); the diagnostic app
             follows the device. Phones honour it; from Android 16, large screens (sw >= 600 dp) ignore
             fixed orientations, so the presenter still handles any orientation (DiscouragedApi). -->
        <!-- #1474：LAUNCHER 改挂无界面跳板，游戏存活时直接把 :game task 带回前台、
             库页不先上来（库页先上会被当可回收裁掉 :game task）；库页不再自挂 filter。 -->
        <activity android:name=".IconEntryActivity" android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" android:noHistory="true"
            android:taskAffinity="" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".LibraryActivity" android:exported="true" android:launchMode="singleTop">
        </activity>
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop"
            android:screenOrientation="${screenOrientation}" tools:ignore="DiscouragedApi"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
        </activity>
        <activity android:name=".GameActivity" android:exported="false" android:process=":game"
            android:launchMode="singleTask" android:taskAffinity="${applicationId}.game"
            android:excludeFromRecents="true" android:screenOrientation="${screenOrientation}"
            tools:ignore="DiscouragedApi"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode" />
    </application>
</manifest>

