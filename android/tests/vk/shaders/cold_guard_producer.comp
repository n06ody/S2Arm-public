#version 450
layout(local_size_x = 1) in;
layout(std430, set = 0, binding = 0) writeonly buffer Counters { uint words[]; } counters;
layout(push_constant) uniform Producer { uint index; uint value; } producer;
void main() {
    if (gl_GlobalInvocationID.x == 0) counters.words[producer.index] = producer.value;
}
