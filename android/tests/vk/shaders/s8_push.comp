#version 450
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 8, local_size_y = 1, local_size_z = 1) in;
layout(push_constant, std430) uniform Pc { u8vec4 a; u8vec4 b; } pc;
layout(set = 0, binding = 0) buffer OutBuf { uint v[8]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < 8u) {
        uvec4 q = (i < 4u) ? uvec4(pc.a) : uvec4(pc.b);
        uint lane = i & 3u;
        uint val = lane == 0u ? q.x : lane == 1u ? q.y : lane == 2u ? q.z : q.w;
        v[i] = val + 0x100u;
    }
}
