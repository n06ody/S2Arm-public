#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
shared uint s_wg[64];
layout(set = 0, binding = 0, std430) writeonly buffer Out {
    uint vals[];
} dst;
void main() {
    uint i = gl_LocalInvocationID.x;
    s_wg[i] = 0x5A5A0000u ^ i;
    barrier();
    dst.vals[i] = s_wg[i];
}
