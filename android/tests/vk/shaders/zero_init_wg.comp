#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
shared uint s_wg[64];
layout(set = 0, binding = 0, std430) writeonly buffer Out {
    uint vals[];
} dst;
void main() {
    uint i = gl_LocalInvocationID.x;
    // 不先写 s_wg，直接读取：配合 OpConstantNull 初始化器验证 VK_KHR_zero_initialize_workgroup_memory。
    dst.vals[i] = s_wg[i] ^ 0xA5A50000u ^ i;
}
