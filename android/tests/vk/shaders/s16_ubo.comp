#version 450
#extension GL_EXT_shader_16bit_storage : require
layout(local_size_x = 8, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std140) uniform InUbo { u16vec4 a; u16vec4 b; };
layout(set = 0, binding = 1) buffer OutBuf { uint v[8]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < 8u) {
        uvec4 q = (i < 4u) ? uvec4(a) : uvec4(b);
        uint lane = i & 3u;
        uint val = lane == 0u ? q.x : lane == 1u ? q.y : lane == 2u ? q.z : q.w;
        v[i] = val ^ 0x5a5au;
    }
}
