#version 450
// #976 采样器用例（有符号整数视图）：同 samp_at.comp，按给定坐标在第 0 级采样一次，结果原样写出。
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform isampler2D t;
layout(set = 0, binding = 1) readonly buffer C { vec2 uv[]; } c;
layout(set = 0, binding = 2) writeonly buffer O { ivec4 v[]; } o;
void main() { uint i = gl_GlobalInvocationID.x; o.v[i] = textureLod(t, c.uv[i], 0.0); }
