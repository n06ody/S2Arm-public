#version 450
layout(local_size_x = 4, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer Out {
    uint vals[];
} out_buf;
void main() {
    uint gid = gl_GlobalInvocationID.x;
    float neg_zero = uintBitsToFloat(0x80000000u);
    float v = (gid == 0u) ? neg_zero : float(gid) * 1.5;
    out_buf.vals[gid] = floatBitsToUint(v);
}
