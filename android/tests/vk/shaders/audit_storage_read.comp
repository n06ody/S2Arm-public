#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, rgba8) readonly uniform image2D input_image;
layout(set = 0, binding = 1) writeonly buffer Output { vec4 value; } output_buffer;
void main() {
#ifdef S2A_TEST_DYNAMIC_IMAGE_READ
    ivec2 coordinate = ivec2(gl_GlobalInvocationID.xy);
#else
    const ivec2 coordinate = ivec2(0, 0);
#endif
    output_buffer.value = imageLoad(input_image, coordinate);
}
